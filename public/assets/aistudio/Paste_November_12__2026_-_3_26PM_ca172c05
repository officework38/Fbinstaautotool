        def update_clock():
            while True:
                now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                try:
                    self.lbl_live_clock.config(
                        text=f"Current System Time: {now_str}"
                    )
                except Exception:
                    break
                time.sleep(1)

        threading.Thread(target=update_clock, daemon=True).start()


