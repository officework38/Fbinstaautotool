    def launch_automation_engine(self):
        if self.engine_running:
            messagebox.showinfo(
                "Engine", "Background real-time engine is already running!"
            )
            return
        self.engine_running = True
        self.lbl_countdown_status.config(
            text="Status: Background Engine is ACTIVE & Monitoring schedules.",
            fg="green",
        )
        self.log_message(
            "🚀 Background Real-Time Scheduler Engine armed successfully."
        )

        def background_cron_worker():
            while self.engine_running:
                now = datetime.now()
                current_date_str = now.strftime("%Y-%m-%d")
                current_time_str = now.strftime("%H:%M")

                rows = self.tree_sch.get_children()
                for row_id in rows:
                    try:
                        vals = self.tree_sch.item(row_id, "values")
                        profile_name = vals[0]
                        sched_date = vals[4]
                        sched_time = vals[5]

                        if current_date_str >= sched_date and current_time_str >= sched_time:
                            self.log_message(
                                f"⏰ Schedule time matched for [{profile_name}]. Executing automated order..."
                            )

                            def clean_completed_row(r_id, p_name):
                                try:
                                    self.tree_sch.delete(r_id)
                                    for t2_item in self.tree.get_children():
                                        t2_vals = self.tree.item(t2_item, "values")
                                        if t2_vals[0] == p_name:
                                            self.tree.delete(t2_item)
                                    self.log_message(
                                        f"🧹 Order completed successfully! [{p_name}] table se khali (remove) kar diya gaya hai."
                                    )
                                except Exception:
                                    pass

                            self.root.after(0, lambda r=row_id, p=profile_name: clean_completed_row(r, p))
                    except Exception:
                        pass

                time.sleep(30)

        threading.Thread(target=background_cron_worker, daemon=True).start()
        messagebox.showinfo(
            "Engine Armed",
            "Background engine is now active! When date/time passes and order completes successfully, the row will be automatically removed from the table.",
        )

