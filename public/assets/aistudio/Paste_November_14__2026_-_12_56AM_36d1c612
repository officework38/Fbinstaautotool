    def execute_real_fb_post(self, target_name, target_type, video_path, caption):
        profile_name = self.entry_profile_name.get().strip() or "Account_1"
        profile_path = os.path.join(self.profiles_dir, profile_name)
        target_url = self.page_urls_map.get(target_name, "https://www.facebook.com/")

        self.log_message(f"🚀 [REAL RPA] Starting execution for [{target_name}] -> {target_url}")

        options = Options()
        options.add_argument("--disable-notifications")
        options.add_argument("--start-maximized")
        options.add_argument(f"user-data-dir={profile_path}")

        driver = self.get_chrome_driver(options=options)
        wait = WebDriverWait(driver, 25)

        try:
            # 1. Navigate to target page URL
            driver.get(target_url)
            time.sleep(5)

            # 2. INTEGRATED 2-STEP SWITCH HANDLER (Step 1: Page Button -> Step 2: Popup Modal Confirmation)
            self.log_message(f"Executing 2-Step Switch verification for [{target_name}]...")
            switched = False

            # STEP 1: Click 'Switch Now' or similar button on the page using explicit wait & multi-fallback
            try:
                switch_button = WebDriverWait(driver, 6).until(
                    EC.element_to_be_clickable(
                        (
                            By.XPATH,
                            "//div[@aria-label='Switch Now' or @aria-label='Switch' or text()='Switch Now'] | //span[text()='Switch Now' or text()='Switch']"
                        )
                    )
                )
                driver.execute_script("arguments[0].click();", switch_button)
                self.log_message("🔄 Step 1: 'Switch Now' button clicked successfully!")
                time.sleep(4)  # Wait for popup modal to appear
            except Exception:
                self.log_message("Step 1 notice: No direct Switch Now button found, checking popup directly.")

            # STEP 2: Wait and click confirmation button inside the 'Switch profiles' popup modal (Up to 15 seconds retry)
            popup_wait_start = time.time()
            while time.time() - popup_wait_start < 15:
                try:
                    popup_switch_btn = WebDriverWait(driver, 3).until(
                        EC.element_to_be_clickable(
                            (
                                By.XPATH,
                                "//div[@role='dialog']//div[@role='button' and (text()='Switch' or contains(., 'Switch'))] | //div[@role='dialog']//span[text()='Switch']"
                            )
                        )
                    )
                    driver.execute_script("arguments[0].click();", popup_switch_btn)
                    self.log_message("✅ Step 2: Popup 'Switch' confirmation button successfully clicked!")
                    switched = True
                    time.sleep(8)  # Wait for full page reload & persona activation
                    break
                except Exception:
                    pass
                time.sleep(1)

            if not switched:
                self.log_message("Notice: No 2-step switch popup required or already active on page persona.")

            # 3. Open Create Post Composer
            self.log_message("Opening post composer...")
            create_post_xpath = "//span[contains(text(), \"What's on your mind\")] | //div[@aria-label=\"Create a post\"]"
            post_box = wait.until(EC.element_to_be_clickable((By.XPATH, create_post_xpath)))
            driver.execute_script("arguments[0].click();", post_box)
            time.sleep(3)

            # 4. Type Caption / Post Text
            self.log_message("Entering post caption...")
            text_box_xpath = "//div[@role='dialog']//div[@contenteditable='true' and @role='textbox']"
            text_box = wait.until(EC.element_to_be_clickable((By.XPATH, text_box_xpath)))
            text_box.click()
            text_box.send_keys(caption)
            time.sleep(2)

            # 5. Upload Media / Video if assigned
            if video_path and video_path != "Not Assigned" and os.path.exists(video_path):
                self.log_message(f"Uploading media file: {video_path}")
                try:
                    photo_video_btn = wait.until(EC.element_to_be_clickable((By.XPATH, "//div[@aria-label='Photo/video' or contains(@aria-label, 'Photo')]")))
                    photo_video_btn.click()
                    time.sleep(2)
                    file_input = wait.until(EC.presence_of_element_located((By.XPATH, "//input[@type='file']")))
                    file_input.send_keys(os.path.abspath(video_path))
                    self.log_message("Waiting for media upload to finish...")
                    time.sleep(10)
                except Exception as media_err:
                    self.log_message(f"Media upload notice: {media_err}")

            # 6. AUTO-CLICK 'NEXT' BUTTON IF IT APPEARS IN POST MODAL
            self.log_message("Checking for 'Next' button in post modal...")
            try:
                time.sleep(3)
                next_btn_xpath = "//div[@role='button']//span[contains(text(), 'Next')] | //div[@role='button' and (contains(@aria-label, 'Next') or text()='Next')]"
                next_btn_elements = driver.find_elements(By.XPATH, next_btn_xpath)
                if next_btn_elements:
                    driver.execute_script("arguments[0].click();", next_btn_elements[0])
                    self.log_message("➡️ 'Next' button clicked successfully!")
                    time.sleep(3)
            except Exception as next_err:
                self.log_message(f"Next button notice: {next_err}")

            # 7. Click Final Publish / Post button
            self.log_message("Publishing final post...")
            post_btn_xpath = "//div[@aria-label='Post' and @role='button'] | //div[contains(text(), 'Post') and @role='button']"
            post_button = wait.until(EC.element_to_be_clickable((By.XPATH, post_btn_xpath)))
            driver.execute_script("arguments[0].click();", post_button)

            time.sleep(6)
            proof_file = os.path.join(self.proofs_dir, f"proof_{int(time.time())}.png")
            driver.save_screenshot(proof_file)
            self.log_message(f"✅ SUCCESS: Post published to [{target_name}]! Screenshot saved: {proof_file}")

        except Exception as e:
            self.log_message(f"❌ RPA Execution Error on [{target_name}]: {str(e)}")
        finally:
            driver.quit()

    def launch_selected_target_rpa_manually(self):
        sel = self.tree_sch.selection()
        if not sel:
            messagebox.showwarning("Select Target", "Please select a page row from the table first!")
            return
        vals = self.tree_sch.item(sel[0], "values")
        self.notebook.select(self.tab_live_terminal)
        threading.Thread(
            target=self.execute_real_fb_post,
            args=(vals[0], vals[1], vals[2], vals[3]),
            daemon=True
        ).start()

    def launch_all_targets_rpa_manually(self):
        items = self.tree_sch.get_children()
        if not items:
            messagebox.showwarning("No Targets", "No pages available in Scheduler table!")
            return
        
        self.notebook.select(self.tab_live_terminal)
        self.log_message("🚀 Starting batch execution for ALL pages in the table...")

        def batch_worker():
            for item in items:
                vals = self.tree_sch.item(item, "values")
                self.execute_real_fb_post(vals[0], vals[1], vals[2], vals[3])
                time.sleep(5)  # Buffer between different pages
            self.log_message("✨ Batch posting to ALL pages completed successfully!")

        threading.Thread(target=batch_worker, daemon=True).start()

    def start_live_clock(self):
        def update_clock():
            now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            self.lbl_live_clock.config(text=f"Current System Time: {now_str}")
            self.root.after(1000, update_clock)
        update_clock()

    def launch_automation_engine(self):
        if self.engine_running:
            return
        self.engine_running = True
        self.lbl_countdown_status.config(text="Status: Background Real-Time Engine is RUNNING...", fg="green")
        self.log_message("🟢 Background Auto-Scheduler Engine STARTED.")

        def scheduler_loop():
            while self.engine_running:
                now = datetime.now()
                for item in list(self.tree_sch.get_children()):
                    vals = self.tree_sch.item(item, "values")
                    try:
                        sched_dt = datetime.strptime(f"{vals[4]} {vals[5]}", "%Y-%m-%d %H:%M")
                        if now >= sched_dt:
                            self.root.after(0, lambda i=item: self.tree_sch.delete(i))
                            self.execute_real_fb_post(vals[0], vals[1], vals[2], vals[3])
                    except Exception:
                        pass
                time.sleep(10)

        threading.Thread(target=scheduler_loop, daemon=True).start()


