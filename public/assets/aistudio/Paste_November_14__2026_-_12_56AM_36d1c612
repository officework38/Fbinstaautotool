    def open_manual_real_browser_login(self):
        profile_name = self.entry_profile_name.get().strip() or "Account_1"

        def manual_login_worker():
            self.log_message(f"Opening browser login session for profile: [{profile_name}]...")
            if not webdriver:
                self.log_message("Selenium is not installed!")
                self.root.after(0, lambda: messagebox.showerror("Error", "Please run: pip install selenium webdriver-manager"))
                return

            try:
                options = Options()
                options.add_argument("--disable-notifications")
                options.add_argument("--start-maximized")
                options.add_argument("--disable-blink-features=AutomationControlled")
                options.add_experimental_option("excludeSwitches", ["enable-automation"])
                options.add_experimental_option("useAutomationExtension", False)

                profile_path = os.path.join(self.profiles_dir, profile_name)
                os.makedirs(profile_path, exist_ok=True)
                options.add_argument(f"user-data-dir={profile_path}")

                driver = self.get_chrome_driver(options=options)
                wait = WebDriverWait(driver, 30)

                driver.get("https://www.facebook.com/")

                try:
                    self.log_message("Checking login session...")
                    wait.until(EC.presence_of_element_located((By.XPATH, "//div[@aria-label='Create a post' or contains(@aria-label, \"What's on your mind\")]")))
                    self.log_message("Already logged in!")
                except:
                    self.log_message("Waiting for user to log in manually in browser...")
                    self.root.after(0, lambda: messagebox.showinfo("Login Required", "Browser window me Facebook login karein.\n\nLogin hone ke baad OK dabayein taaki pages fetch ho sakein."))
                    wait.until(EC.presence_of_element_located((By.XPATH, "//div[@aria-label='Create a post' or contains(@aria-label, \"What's on your mind\")]")))
                    self.log_message("Login successful!")

                time.sleep(2)

                cookies = driver.get_cookies()
                cookie_str = "".join([f"{c['name']}={c['value']}; " for c in cookies])
                if cookie_str:
                    self.root.after(0, lambda: self.txt_accounts.delete("1.0", tk.END))
                    self.root.after(0, lambda: self.txt_accounts.insert(tk.END, cookie_str + "\n"))

                target_url = "https://www.facebook.com/pages/?category=your_pages"
                self.log_message(f"Fetching managed pages from: {target_url}")
                driver.get(target_url)
                time.sleep(5)

                links = driver.find_elements(By.XPATH, "//div[@role='main']//a[@role='link']")
                fetched_pages = []
                seen_urls = set()

                # STRICT FILTER: Exclude notifications, messages, profile, settings, numbers
                ignore_words = [
                    "Switch", "Promote", "Create", "View", "Insights", "Manage", 
                    "See all", "Discover", "Liked Pages", "Invites", "Notification", 
                    "Message", "Profile", "Settings", "Marketplace", "Groups", "Watch", "Memories"
                ]

                for link in links:
                    name = link.text.strip()
                    href = link.get_attribute("href")

                    if name and href and "facebook.com" in href:
                        if any(char.isdigit() for char in name):
                            continue
                        
                        name_lower = name.lower()
                        if any(w.lower() in name_lower for w in ignore_words):
                            continue

                        if len(name) > 1:
                            clean_url = href.split('?')[0] if 'profile.php' not in href else href
                            if clean_url not in seen_urls:
                                seen_urls.add(clean_url)
                                fetched_pages.append({"name": name, "url": href})
                                self.page_urls_map[name] = href

                curr_d = datetime.now().strftime("%Y-%m-%d")
                curr_t = datetime.now().strftime("%H:%M")

                self.root.after(0, lambda: [self.tree.delete(i) for i in self.tree.get_children()])
                self.root.after(0, lambda d=curr_d, t=curr_t: self.tree.insert("", tk.END, values=("Main Profile", "Profile", "Not Assigned", "#viral #trending", d, t, "Browse", "Remove")))

                if fetched_pages:
                    for page_obj in fetched_pages:
                        p_name = page_obj["name"]
                        self.root.after(0, lambda name=p_name, d=curr_d, t=curr_t: self.tree.insert("", tk.END, values=(name, "Page", "Not Assigned", "#trending #viral", d, t, "Browse", "Remove")))

                    self.log_message(f"✅ Successfully fetched {len(fetched_pages)} Pure Real Pages and added to Tab 2 Inline Table!")
                    self.root.after(0, lambda: messagebox.showinfo("Success", f"{len(fetched_pages)} Pure Pages fetch ho gaye hain!"))
                else:
                    self.log_message("⚠️ No extra pages found. Main Profile added.")
                    self.root.after(0, lambda: messagebox.showinfo("Notice", "Main Profile add kar di gayi hai."))

                driver.quit()
                self.root.after(0, lambda: self.notebook.select(self.tab_content))

            except Exception as e:
                self.log_message(f"Error during login/fetching: {str(e)}")
                self.root.after(0, lambda: messagebox.showerror("Error", f"Browser error: {str(e)}"))

        threading.Thread(target=manual_login_worker, daemon=True).start()

